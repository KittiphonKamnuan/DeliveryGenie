generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model api_usages {
  id               String   @id
  api_name         String
  endpoint         String?
  request_count    Int      @default(1)
  response_time_ms Int?
  status_code      Int?
  error_message    String?
  cost_estimate    Float?
  usage_date       DateTime @default(now())

  @@index([api_name, usage_date])
}

model customers {
  id             String   @id
  name           String
  phone          String   @unique
  email          String?
  address_line1  String
  address_line2  String?
  district       String
  city           String
  postal_code    String?
  latitude       Float
  longitude      Float
  delivery_notes String?
  priority_level String   @default("standard")
  created_at     DateTime @default(now())
  updated_at     DateTime
  orders         orders[]

  @@index([latitude, longitude])
  @@index([phone])
  @@index([priority_level])
}

model deliveries {
  id                     String    @id
  delivery_number        String    @unique
  order_id               String
  driver_id              String
  vehicle_id             String
  route_id               String?
  delivery_status        String    @default("pending")
  pickup_location        String?
  pickup_latitude        Float?
  pickup_longitude       Float?
  pickup_time            DateTime?
  delivery_location      String?
  delivery_latitude      Float?
  delivery_longitude     Float?
  delivery_time          DateTime?
  estimated_distance_km  Float?
  actual_distance_km     Float?
  estimated_duration_min Int?
  actual_duration_min    Int?
  planned_arrival        DateTime?
  actual_arrival         DateTime?
  delay_minutes          Int?
  failure_reason         String?
  notes                  String?
  created_at             DateTime  @default(now())
  updated_at             DateTime
  drivers                drivers   @relation(fields: [driver_id], references: [id])
  orders                 orders    @relation(fields: [order_id], references: [id])
  routes                 routes?   @relation(fields: [route_id], references: [id])
  vehicles               vehicles  @relation(fields: [vehicle_id], references: [id])

  @@index([delivery_number])
  @@index([delivery_status])
  @@index([driver_id])
  @@index([route_id])
  @@index([vehicle_id])
}

model delivery_histories {
  id                String   @id
  delivery_date     DateTime
  day_of_week       Int
  hour_of_day       Int
  origin_latitude   Float
  origin_longitude  Float
  dest_latitude     Float
  dest_longitude    Float
  district          String?
  city              String
  distance_km       Float
  duration_min      Int
  order_count       Int
  total_value       Float
  priority_avg      Float?
  traffic_condition String
  weather_condition String
  temperature       Float?
  on_time           Boolean
  delay_minutes     Int?
  success_rate      Float?
  vehicle_type      String
  driver_rating     Float?
  created_at        DateTime @default(now())

  @@index([delivery_date])
  @@index([district, city])
  @@index([traffic_condition])
}

model drivers {
  id                 String          @id
  employee_id        String          @unique
  first_name         String
  last_name          String
  phone              String          @unique
  email              String?
  license_number     String
  license_type       String
  status             String          @default("active")
  rating             Float?
  total_deliveries   Int             @default(0)
  on_time_rate       Float?
  
  // Vehicle Relation (1:1) - รถ 1 คัน คนขับ 1 คน
  current_vehicle_id String?         @unique
  current_vehicle    vehicles?       @relation(fields: [current_vehicle_id], references: [id])

  store_id           String?   
  store              stores?   @relation(fields: [store_id], references: [id])

  created_at         DateTime        @default(now())
  updated_at         DateTime
  
  deliveries         deliveries[]
  gps_trackings      gps_trackings[]

  // User Relation (1:1) - User 1 คน เป็น Driver ได้ 1 คน
  user_id            String          @unique
  user               users           @relation(fields: [user_id], references: [id])

  @@index([employee_id])
  @@index([phone])
  @@index([status])
  @@index([user_id])
}

model gps_trackings {
  id            String   @id
  driver_id     String
  vehicle_id    String
  latitude      Float
  longitude     Float
  altitude      Float?
  accuracy      Float?
  speed         Float?
  heading       Float?
  battery_level Int?
  is_moving     Boolean  @default(false)
  timestamp     DateTime @default(now())
  recorded_date DateTime @default(now())
  drivers       drivers  @relation(fields: [driver_id], references: [id])
  vehicles      vehicles @relation(fields: [vehicle_id], references: [id])

  @@index([driver_id, timestamp])
  @@index([latitude, longitude])
  @@index([recorded_date])
  @@index([vehicle_id, timestamp])
}

model order_items {
  id                  String   @id
  order_id            String
  product_id          String
  quantity            Int
  unit_price          Float
  subtotal            Float
  expiration_datetime DateTime
  temperature_zone    String?
  created_at          DateTime @default(now())
  orders              orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products            products @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
}

model orders {
  id                        String                      @id
  order_number              String                      @unique
  customer_id               String
  order_date                DateTime                    @default(now())
  delivery_date             DateTime
  delivery_window_start     DateTime
  delivery_window_end       DateTime
  customer_priority         String
  order_status              String                      @default("pending")
  delivery_address          String
  delivery_latitude         Float
  delivery_longitude        Float
  delivery_notes            String?
  subtotal                  Float
  tax                       Float                       @default(0)
  shipping_fee              Float                       @default(0)
  total_amount              Float
  priority_score            Float?
  priority_class            String?
  priority_rank             Int?
  priority_breakdown        Json?
  estimated_delivery        DateTime?
  actual_delivery           DateTime?
  delay_minutes             Int?
  created_at                DateTime                    @default(now())
  updated_at                DateTime
  deliveries                deliveries[]
  order_items               order_items[]
  customers                 customers                   @relation(fields: [customer_id], references: [id])
  priority_calculation_logs priority_calculation_logs[]

  store_id    String 
  stores      stores   @relation(fields: [store_id], references: [id])

  @@index([customer_id])
  @@index([delivery_date])
  @@index([order_number])
  @@index([order_status])
  @@index([priority_class])
  @@index([priority_score])
  @@index([store_id]) // แนะนำให้เพิ่ม Index เพื่อความเร็วในการค้นหา Order ตามสาขา
}

model performance_metrics {
  id                 String   @id
  metric_type        String
  metric_date        DateTime
  entity_id          String?
  entity_type        String?
  total_deliveries   Int      @default(0)
  successful         Int      @default(0)
  failed             Int      @default(0)
  on_time            Int      @default(0)
  delayed            Int      @default(0)
  avg_delay_min      Float?
  avg_distance_km    Float?
  avg_duration_min   Float?
  avg_priority_score Float?
  total_distance_km  Float?
  total_revenue      Float?
  total_fuel_used    Float?
  created_at         DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([metric_type, metric_date])
}

model priority_calculation_logs {
  id                String   @id
  order_id          String
  input_data        Json
  priority_score    Float
  priority_class    String
  breakdown         Json
  temperature_score Float
  expiration_score  Float
  customer_score    Float
  value_score       Float
  time_window_score Float
  fragility_score   Float
  config_used       String   @default("default")
  calculated_at     DateTime @default(now())
  orders            orders   @relation(fields: [order_id], references: [id])

  @@index([calculated_at])
  @@index([order_id])
}

model priority_configs {
  id                 String   @id
  config_name        String   @unique
  description        String?
  weight_temperature Float    @default(0.30)
  weight_expiration  Float    @default(0.25)
  weight_customer    Float    @default(0.15)
  weight_value       Float    @default(0.10)
  weight_time_window Float    @default(0.15)
  weight_fragility   Float    @default(0.05)
  thresholds         Json?
  is_active          Boolean  @default(false)
  created_by         String?
  created_at         DateTime @default(now())
  updated_at         DateTime
}

model products {
  id                       String              @id
  sku                      String              @unique
  name                     String
  description              String?
  category                 String
  base_price               Float
  temperature_requirement  String
  temp_min_celsius         Float?
  temp_max_celsius         Float?
  typical_expiration_hours Int
  is_fragile               Boolean             @default(false)
  weight_kg                Float?
  dimensions               Json?
  is_active                Boolean             @default(true)
  created_at               DateTime            @default(now())
  updated_at               DateTime
  order_items              order_items[]
  store_inventories        store_inventories[]

  @@index([category])
  @@index([sku])
  @@index([temperature_requirement])
}

model route_stops {
  id                 String    @id
  route_id           String
  stop_order         Int
  order_id           String?
  stop_type          String
  address            String
  latitude           Float
  longitude          Float
  estimated_arrival  DateTime?
  actual_arrival     DateTime?
  estimated_duration Int?
  actual_duration    Int?
  distance_from_prev Float?
  status             String    @default("pending")
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime
  routes             routes    @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@index([route_id, stop_order])
  @@index([status])
}

model routes {
  id                 String        @id
  route_number       String        @unique
  origin_store_id    String
  driver_id          String?
  vehicle_id         String?
  route_date         DateTime
  route_status       String        @default("planned")
  total_distance_km  Float?
  total_duration_min Int?
  total_orders       Int           @default(0)
  optimization_score Float?
  route_polyline     String?
  route_geometry     Json?
  google_route_token String?
  traffic_condition  String?
  started_at         DateTime?
  completed_at       DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime
  deliveries         deliveries[]
  route_stops        route_stops[]
  stores             stores        @relation(fields: [origin_store_id], references: [id])

  @@index([origin_store_id])
  @@index([route_date])
  @@index([route_status])
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model store_inventories {
  id              String    @id
  store_id        String
  product_id      String
  quantity        Int
  expiration_date DateTime?
  last_updated    DateTime
  products        products  @relation(fields: [product_id], references: [id])
  stores          stores    @relation(fields: [store_id], references: [id])

  @@unique([store_id, product_id])
  @@index([product_id])
  @@index([store_id])
}

model stores {
  id                String              @id
  store_code        String              @unique
  name              String
  branch_name       String?
  address           String
  district          String
  city              String
  province          String
  postal_code       String?
  latitude          Float
  longitude         Float
  phone             String?
  opening_hours     Json?
  is_24_hours       Boolean             @default(true)
  is_active         Boolean             @default(true)
  has_parking       Boolean             @default(false)
  created_at        DateTime            @default(now())
  updated_at        DateTime
  routes            routes[]
  store_inventories store_inventories[]
  drivers           drivers[]
  orders            orders[]  // ร้านค้า 1 ร้าน มี Order ได้หลายรายการ

  @@index([city, district])
  @@index([is_active])
  @@index([latitude, longitude])
}

model system_logs {
  id         String   @id
  log_level  String
  log_type   String
  message    String
  details    Json?
  user_id    String?
  ip_address String?
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([log_level])
  @@index([log_type])
}

model traffic_data {
  id                String   @id
  start_latitude    Float
  start_longitude   Float
  end_latitude      Float
  end_longitude     Float
  route_polyline    String?
  traffic_condition String
  travel_time_sec   Int
  static_time_sec   Int
  delay_sec         Int
  traffic_speed_kmh Float?
  data_source       String   @default("google_maps")
  confidence_score  Float?
  timestamp         DateTime @default(now())
  expires_at        DateTime

  @@index([start_latitude, start_longitude])
  @@index([timestamp])
  @@index([traffic_condition])
}

model users {
  id            String     @id
  name          String
  email         String     @unique
  password      String
  role          String     @default("user")
  image         String?
  emailVerified DateTime?
  isActive      Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime
  accounts      accounts[]
  sessions      sessions[]

  driver        drivers?

  @@index([email])
  @@index([role])
}

model vehicles {
  id                 String          @id
  vehicle_number     String          @unique
  vehicle_type       String
  license_plate      String          @unique
  temperature_zones  Json?
  capacity_weight_kg Float
  capacity_volume_m3 Float?
  fuel_type          String?
  fuel_efficiency    Float?
  current_status     String          @default("available")
  last_maintenance   DateTime?
  created_at         DateTime        @default(now())
  updated_at         DateTime
  
  deliveries         deliveries[]
  gps_trackings      gps_trackings[]
  
  // Relation กลับไปหา Driver
  current_driver     drivers?

  @@index([current_status])
  @@index([vehicle_type])
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model weather_data {
  id            String    @id
  station_id    String?
  district      String?
  city          String
  latitude      Float?
  longitude     Float?
  temperature   Float
  humidity      Int
  rainfall      Float?
  wind_speed    Float?
  condition     String
  visibility    Float?
  timestamp     DateTime  @default(now())
  forecast_date DateTime?

  @@index([city, timestamp])
  @@index([condition])
}
